# Copy to .env and fill in. .env is gitignored; this file is committed.
# No credential belongs in this file or in any other committed file.

# --- Data layer -------------------------------------------------------------
POLYGON_API_KEY=

# --- IBKR connection (monitor) ----------------------------------------------
# There are NO IBKR credentials here. IB Gateway holds the authenticated
# session; the API socket on localhost requires no authentication. These are
# connection coordinates only.
#
# IB_PORT is the ONLY thing separating paper from live: 4002 paper, 4001 live.
# The monitor logs the port and account on connect so a misconfigured deploy
# announces itself immediately.
IB_HOST=127.0.0.1
IB_PORT=4002
# Every ib_async example uses 0 or 1; reconnecting with an id still held by a
# half-dead session fails. Use something you own.
IB_CLIENT_ID=11
# Optional. Set to disambiguate if the login manages more than one account.
IB_ACCOUNT=

# --- Monitor ----------------------------------------------------------------
# base_capital is an ALLOCATION DECISION -- the capital deliberately committed
# to this pair. It is not NLV, and it never changes in response to price, P&L,
# or account value. See docs/STRATEGY_SPEC.md section 1 for why.
MONITOR_BASE_CAPITAL=

# Persisted state (peak_equity only; target is always derived, never stored).
# Defaults to <repo>/data/state/monitor.json for local dev. In deployment this
# MUST live outside the repo tree -- a git pull or re-clone that wipes it resets
# the peak and silently disables the drawdown stop, with nothing in the logs to
# say the safety net is gone.
#
# On the VPS:  MONITOR_STATE_PATH=/var/lib/short-lev/monitor.json
# The monitor unit's StateDirectory=short-lev creates and chowns that directory
# on start, so there is no mkdir step.
MONITOR_STATE_PATH=

# Seconds between checks. 900 = the 15-minute target cadence.
POLL_INTERVAL_SECONDS=900

# --- Band parameters (optional overrides) -----------------------------------
# Defaults live in src/config.py and match the backtest. Override only with a
# reason: a monitor alerting on different thresholds than the backtest measured
# is reporting on a strategy nobody tested.
# LONG_SHORT_BAND=0.10
# FOIL_DECAY_BAND=0.10
# CAPITAL_UTILIZATION=0.75
# DRAWDOWN_STOP=0.10
# MARGIN_DERISK=true

# --- Telegram (spec 006) ----------------------------------------------------
# Leave BOTH blank to disable Telegram entirely: the monitor then runs normally,
# logs to console and JSONL, sends nothing, and raises nothing. That is a
# supported mode, not a degraded one.
#
# THE BOT TOKEN IS A FULL CREDENTIAL -- anyone holding it controls the bot and
# can read and send everything it can. It belongs in .env only. It is never
# committed and never logged, not even at DEBUG.
# See docs/AUTOMATION.md for creating the bot and finding the chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Alerting and event log (spec 006) --------------------------------------
# Append-only JSONL: checks.jsonl (one line per check, tripped or NOT) and
# alerts.jsonl (one line per send attempt, delivered or NOT). Defaults to
# <repo>/data/events. Point this OUTSIDE the repo tree in deployment, same
# reasoning as MONITOR_STATE_PATH -- though losing it costs history, not safety.
#
# On the VPS:  EVENT_LOG_DIR=/var/lib/short-lev/events
EVENT_LOG_DIR=

# Dedup state: what was last alerted, when, and the last heartbeat date.
# Defaults to <repo>/data/state/alert_state.json. Deliberately SEPARATE from
# monitor.json: losing this costs one duplicate message, losing peak_equity
# silently disables the drawdown stop. Different consequences, different files.
#
# On the VPS:  ALERT_STATE_PATH=/var/lib/short-lev/alert_state.json
ALERT_STATE_PATH=

# How often a STANDING trip re-sends, in minutes. A tripped band stays tripped
# until a human acts, so it must nag rather than vanish -- but not once per
# poll, which is an alert you learn to mute. Default 60.
ALERT_REPEAT_MINUTES=60

# Daily heartbeat, ALWAYS interpreted in ET regardless of this box's timezone,
# "HH:MM" or a bare hour. Default 09:45, just after the open -- an ET fact, so
# it is read in ET rather than local time.
#
# It fires once inside a 30-minute window starting at this time, NOT on the
# first poll after it. Open-ended meant any restart later in the day sent one
# immediately, and a heartbeat at an arbitrary time cannot do its job. Past the
# window it skips the day rather than firing late.
#
# This is a heartbeat you must notice MISSING -- if the monitor dies at 02:00
# you find out at 09:45. Acceptable for a monitor that executes nothing; not
# acceptable once an executor exists. See docs/AUTOMATION.md.
HEARTBEAT_HOUR=09:45

# --- Command bot and approval loop (spec 008) --------------------------------
# The bot (src/bot.py, short-lev-bot.service) shares this .env with the
# monitor. It reuses TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID above; group
# membership on that chat id IS the authorization model, so adding someone to
# the group is granting them the bot.
#
# Optional comma-separated Telegram USER ids allowed to press the
# Rebalance/Confirm buttons. Empty means everyone in the group. Flagged for
# review in spec 008: empty costs nothing today because the terminal step is a
# placeholder, and is the thing to revisit before that ever changes.
TELEGRAM_ACTION_USER_IDS=

# Basis points THROUGH the mark for risk-reducing (margin de-risk, drawdown
# stop) limit prices. A marketable limit fills like a market order but caps
# the damage from a stale quote. Default 25; a guess pending observed
# TSLL/TSLA spreads.
MARKETABLE_OFFSET_BP=25

# State files shared between the monitor and the bot. All default into
# <repo>/data/state for local dev; on the VPS all four live in
# /var/lib/short-lev, same reasoning as MONITOR_STATE_PATH.
#
# On the VPS:  RUNTIME_STATE_PATH=/var/lib/short-lev/runtime.json
#              BOT_OFFSET_PATH=/var/lib/short-lev/bot_offset.json
#              INTENTS_PATH=/var/lib/short-lev/intents.jsonl
#              INTENTS_SEEN_PATH=/var/lib/short-lev/intents_seen.json
#              APPROVAL_STATE_PATH=/var/lib/short-lev/approval_state.json
RUNTIME_STATE_PATH=
BOT_OFFSET_PATH=
INTENTS_PATH=
INTENTS_SEEN_PATH=
APPROVAL_STATE_PATH=

# --- Execution rails (spec 009 prep) -----------------------------------------
# There is still NO order submission in this repo. These rails exist so that
# when spec 009 adds the submit call, it lands behind defaults that all refuse.
# The gate lives in src/execution.py:submission_gate -- one function, one
# return, one line to audit.
#
# DRY_RUN: anything but an explicit "0" is a dry run -- the executor path
# computes everything, logs the full ticket to orders.jsonl with status
# "dry_run", alerts as if it had submitted, and submits nothing.
DRY_RUN=1
# Must be exactly "1" for a live submission. Going live is therefore a
# two-flag decision plus two absent files, on purpose.
EXECUTION_ENABLED=
# Per-leg order ceiling as a multiple of target notional. Default 0.5. Note
# it refuses a full drawdown-stop close by design; see src/execution.py for
# why that is deliberate until spec 009 decides otherwise.
MAX_ORDER_MULTIPLE=
# The kill switch is a FILE, not an env var: `touch /var/lib/short-lev/HALT`
# stops submission with no restart, no deploy. Override the path only for
# local testing.
# EXECUTION_HALT_PATH=
# Written when working orders are found at connect; delete it after
# reconciling to unblock submission. Defaults into <repo>/data/state.
# On the VPS:  ORPHAN_FLAG_PATH=/var/lib/short-lev/orphan_orders.json
ORPHAN_FLAG_PATH=
