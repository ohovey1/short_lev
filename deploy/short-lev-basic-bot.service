[Unit]
# The Telegram command poller for what-if. Answers /calc to pull live prices 
# from IB Gateway on read only, checks both bands for hypothetical/given position.
# No persisted state, doesn't touch var/li/short-lib
Description=short-lev: telegram calc bot
After=network-online.target short-lev-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=short-lev
Group=short-lev
WorkingDirectory=/opt/short_lev
EnvironmentFile=/opt/short_lev/.env

# Same interpreter arrangement as the monitor unit: the project is a uv
# virtual root with flat imports, so PYTHONPATH stands in for an install.
Environment=PYTHONPATH=/opt/short_lev/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/short_lev/.venv/bin/python /opt/short_lev/src/basic_bot.py

Restart=always
RestartSec=10

# No StateDirectory

# Full hardening, same block as the monitor: the bot writes only its state
# files under /var/lib/short-lev.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/short-lev /opt/short_lev/.venv /home/short-lev/.local /home/short-lev/.cache

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target