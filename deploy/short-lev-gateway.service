[Unit]
# IB Gateway, started and logged in by IBC. This is the unit that makes a reboot
# unattended: IBC types the credentials into Gateway's login dialog so nobody
# has to do it over VNC.
Description=short-lev: IB Gateway via IBC
Requires=short-lev-xvfb.service
After=short-lev-xvfb.service

[Service]
Type=simple
User=short-lev
Group=short-lev
Environment=DISPLAY=:10

# -inline IS REQUIRED. Without it gatewaystart.sh launches an xterm in the
# background and returns 0 in about 34ms. systemd sees the main process exit,
# Restart=always fires, and the unit restarts every 30 seconds forever while
# Gateway itself is fine. -inline makes the script exec in the foreground so the
# unit tracks the real process. Do not remove it.
ExecStart=/opt/ibc/gatewaystart.sh -inline
Restart=always

# 30, not 10. A Gateway that is failing because it needs fresh authentication is
# not helped by restarting every ten seconds, and IBKR throttles repeated login
# attempts -- hammering it turns a two-minute manual fix into a lockout.
RestartSec=30

# HARDENING IS DELIBERATELY LOOSER THAN THE MONITOR'S. Gateway writes to ~/Jts
# constantly -- settings, logs, and its own auto-restart state -- so
# ProtectHome=read-only breaks it. That is a real constraint, not an oversight:
# do not "tighten" this to match short-lev-monitor.service.
NoNewPrivileges=true

# MUST be false. Xvfb's socket lives in /tmp/.X11-unix, and PrivateTmp gives the
# unit its own /tmp namespace where that socket does not exist -- Gateway then
# cannot reach the display at all. The monitor keeps PrivateTmp=true because it
# never touches X. Do not "tighten" this one to match.
PrivateTmp=false

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
