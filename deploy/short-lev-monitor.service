[Unit]
# The monitor loop. Reads the position, evaluates the bands, alerts. Never
# trades -- there is no order-submission code in the repo, not behind a flag.
Description=short-lev: band monitor
After=short-lev-gateway.service
Wants=short-lev-gateway.service

# After= IS ORDERING, NOT READINESS. systemd starts this the moment Gateway's
# PROCESS exists, which is well before Gateway is logged in and serving the API
# socket. The monitor's connect_with_backoff() is what actually handles that gap
# -- one WARNING per retry, exponential backoff, never exits. Do not try to
# solve it here with unit ordering; there is no ordering that expresses "logged
# in and answering on 4002".
#
# Wants= rather than Requires= for the same reason: if Gateway is briefly down,
# the monitor should sit in its backoff loop and report the gap, not be stopped.

[Service]
Type=simple
User=short-lev
Group=short-lev
WorkingDirectory=/opt/short_lev
EnvironmentFile=/opt/short_lev/.env

# The project is a uv VIRTUAL root -- no console entry point, and modules import
# each other flat -- so PYTHONPATH does what an installed package would.
# Calling the venv interpreter directly rather than `uv run` avoids needing
# HOME and PATH for the per-user uv under ProtectHome=read-only.
Environment=PYTHONPATH=/opt/short_lev/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/short_lev/.venv/bin/python /opt/short_lev/src/monitor.py

Restart=always
RestartSec=10

# Creates and chowns /var/lib/short-lev on start, so there is no mkdir step and
# the state survives a re-clone of /opt/short_lev. peak_equity living inside the
# git checkout was the bug: a destructive pull wiped it and silently disabled
# the drawdown stop, with nothing in the logs to say the safety net was gone.
StateDirectory=short-lev

# FULL HARDENING, unlike the Gateway unit. The monitor has no reason to write
# anywhere except its state directory. ReadWritePaths punches specific holes
# through ProtectSystem/ProtectHome -- the .venv and the uv caches so a sync can
# run, /var/lib/short-lev for state and the event log.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/short-lev /opt/short_lev/.venv /home/short-lev/.local /home/short-lev/.cache

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
